# Copy to .env and fill in the values. Never commit .env.

# --- Coordinator model ---
# deepseek: DeepSeek API (default model deepseek-flash). qwen: a self-hosted OpenAI-compatible server.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_MODEL=deepseek-flash                     # optional model override
# QWEN_REMOTE_BASE_URL=https://your-openai-compatible-endpoint/v1   # used when LLM_PROVIDER=qwen
# QWEN_REMOTE_API_KEY=your-coordinator-api-key
# QWEN_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q6_K_M   # optional model override

# --- Public web search (Gemini with Google Search grounding) ---
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.7-flash                   # optional model override

# --- Alternative web search (not active; tools/tavily_tool.py) ---
# TAVILY_API_KEY=your-tavily-api-key

# --- Knowledge base (RAGFlow) ---
# The RAGFlow host is reached through an SSH tunnel; RAGFLOW_BASE_URL is the tunnel's local end:
#   ssh -N -L 8080:localhost:80 <ragflow-host>
# API key: RAGFlow web UI -> avatar menu -> API. RAGFLOW_API_URL is still read as a legacy fallback.
RAGFLOW_BASE_URL=http://localhost:8080
RAGFLOW_API_KEY=your-ragflow-api-key
# RAGFLOW_DATASET=handbook                        # optional default knowledge base(s), comma-separated

# --- Business database (MongoDB, queried through mongodb-mcp-server, read-only) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/pharma_db
MONGODB_DATABASE=pharma_db
# MONGODB_MCP_COMMAND=mongodb-mcp-server          # default: global binary if installed, else npx
# MONGODB_MCP_ARGS=                               # extra arguments for the MCP server

# --- Tracing and eval datasets (LangSmith, optional) ---
# With tracing on, every agent run in this process (app, run_baseline.py) is sent to LangSmith.
# The API key is also used by evals/golden/push_langsmith.py. tests/conftest.py forces tracing off.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=deep-search

# --- Evaluation judge (Azure AI Foundry / Azure OpenAI deployment; evals only) ---
# AZURE_ENDPOINT is the resource's OpenAI-compatible base URL, e.g. https://<resource>.openai.azure.com/openai/v1
# AZURE_ENDPOINT=
# AZURE_API_KEY=
# AZURE_DEPLOYMENT_NAME=claude-sonnet-5-5
# A claude-* deployment (e.g. claude-sonnet-5-5) is called through the resource's Anthropic endpoint
# with the same key; Ragas then uses this OpenAI-API deployment instead (default gpt-6.1-sol).
# AZURE_RAGAS_DEPLOYMENT_NAME=gpt-6.1-sol
# Judge reasoning effort: low | medium | high (default medium; higher costs more per judge call)
# AZURE_REASONING_EFFORT=medium

# --- Session storage ---
# DEEP_SEARCH_OUTPUT_DIR=./output                 # default: <project>/output
